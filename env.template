# Copy this file to .env and replace values marked CHANGE_ME.
# .env is ignored by Git. Do not commit passwords or API keys.

# Qdrant vector database
# Local Docker Qdrant uses this value and does not require an API key.
QDRANT_VECTOR_DB_URL=http://localhost:6333
QDRANT_API_KEY=

# Neo4j graph database
# Local Docker Neo4j uses bolt://localhost:7687 and the password chosen below.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME
NEO4J_DATABASE=neo4j

# Optional services. Leave blank unless you use these integrations.
OPENAI_API_KEY=
BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

DB_URL='host.docker.internal:20000'
DB_USERNAME=
DB_PASSWORD=