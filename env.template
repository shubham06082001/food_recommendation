# Copy this file to .env and replace values marked CHANGE_ME. .env is ignored by Git: never commit secrets.
# (If a real .env was ever committed, rotate every password and key that was in it.)

# --- Required ---------------------------------------------------------------
# Manager login (applied on every start-up: changing the password here and restarting updates it).
ECOS_MANAGER_ID=MGR001
ECOS_MANAGER_PASSWORD=CHANGE_ME_min_8_chars

# MongoDB: either one URI (Atlas: mongodb+srv://user:pass@cluster/...) ...
ECOS_MONGODB_URI=mongodb://localhost:27017
ECOS_MONGODB_DB=Food_Recipe
# ... or the older host/credentials form (used only when ECOS_MONGODB_URI is empty):
# DB_URL=localhost:27017
# DB_USERNAME=
# DB_PASSWORD=

# Qdrant holds the food catalog (collection `food_nutrients`). The menu is synced from it automatically.
QDRANT_VECTOR_DB_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Optional ---------------------------------------------------------------
# ECOS_CATALOG_REFRESH_HOURS=24     # how often the catalog is re-read from Qdrant
# ECOS_SEED_DEMO=false              # true adds demo ingredients/recipes with stock lines
# ECOS_ENRICH=true                  # false disables dish-photo lookup (Wikimedia Commons)
# ECOS_MODEL_LOCAL_ONLY=true        # false lets the embedding model download on first use
# PORT=8501                         # public UI port (hosts set this); the API stays on 127.0.0.1:8000

# Copilot LLM (optional; rules are used when blank). Needs the extra packages in pyproject.toml.
OPENAI_API_KEY=
BASE_URL=
