{
  "name": "ecos-dev",
  "image": "harbor.tools.telstra.com/public-cache/library/python:3.12",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8000, 8501],
  "remoteEnv": {
    "ECOS_MONGODB_URI": "mongodb://host.docker.internal:20000",
    "ECOS_MONGODB_DB": "Food_Recipe",
    "PATH": "/workspaces/Food_Recommendation/.venv/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "jetbrains": { "backend": "IntelliJ" }
  }
}
